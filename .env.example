# Server
PORT=3000
NODE_ENV=production
JWT_KEY=change-this-to-a-long-random-secret

# MySQL (phpMyAdmin / local MySQL on VPS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=next_ecom
DB_PASSWORD=your-strong-db-password
DB_NAME=next_ecom
DB_CONNECTION_LIMIT=25

# FTP / media (Hostinger file manager or separate FTP host)
FTP_HOST=your-ftp-host
FTP_USER=your-ftp-user
FTP_PASSWORD=your-ftp-password
FTP_SECURE=false
FTP_BASE_URL=https://media.yourdomain.com
FTP_UPLOAD_DIR=/public_html/
